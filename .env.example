# 둘 중 하나만 있어도 됩니다. 둘 다 없으면 '로컬 모핑' 모드만 사용 가능.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium      # low | medium | high (high 는 더 비싸고 느림)
# OPENAI_INPUT_FIDELITY=high       # 입력 얼굴 보존력. 모델이 지원 안 하면 빈 값으로

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# PORT=5173
